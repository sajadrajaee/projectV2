SECRET_KEY=replace-with-a-unique-random-secret-at-least-50-characters-long
DEBUG=False
ALLOWED_HOSTS=your-api-host.example.com
CSRF_TRUSTED_ORIGINS=https://your-api-host.example.com

# MySQL defaults. Set DB_ENGINE to django.db.backends.postgresql for PostgreSQL.
DB_ENGINE=django.db.backends.mysql
DB_NAME=your_database
DB_USER=your_database_user
DB_PASSWORD=replace-me
DB_HOST=your-database-host
DB_PORT=3306
DB_CONN_MAX_AGE=60

# Set the frontend origin only when frontend and API use separate origins.
CORS_ALLOWED_ORIGINS=https://your-frontend-host.example.com
FRONTEND_URL=https://your-frontend-host.example.com

# Use a persistent disk or object storage for uploaded media in production.
MEDIA_ROOT=/var/lib/khanayab/media
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600

# Configure SMTP for registration and password reset email in production.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=replace-me
DEFAULT_FROM_EMAIL=your-email@example.com